// Only for bundling Cirrus into one module Miniflare can load (`yarn build:engines`). Terrarium supplies the bindings and vars itself at run time.
{
  "name": "terrarium-cirrus",
  "main": "entry.ts",
  "compatibility_date": "2025-12-02",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "pino": "pino/browser.js" }
}
